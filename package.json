{
  "name": "@ipwho/ipwho",
  "version": "2.0.0",
  "description": "Official TypeScript/JavaScript SDK for the IPWho IP geolocation API (lookup, me, bulk).",
  "type": "module",
  "main": "./src/ipwho.js",
  "types": "./src/ipwho.d.ts",
  "exports": {
    ".": {
      "types": "./src/ipwho.d.ts",
      "import": "./src/ipwho.js"
    }
  },
  "files": [
    "src/ipwho.js",
    "src/ipwho.d.ts",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://www.ipwho.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavrox/SDK-IPWho-IP-Geolocation-Typescript.git"
  },
  "bugs": {
    "url": "https://github.com/lavrox/SDK-IPWho-IP-Geolocation-Typescript/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ipwho",
    "ip geolocation",
    "geoip",
    "ip lookup",
    "typescript sdk"
  ]
